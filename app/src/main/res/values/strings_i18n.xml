    <!-- WhatsApp messages sent to customers -->
    <string name="wa_intake">*%1$s* - Job Intake Confirmation\n\nHello *%2$s*,\nYour device *%3$s* has been booked for diagnosis.\n\n📋 *Job Card:* #%4$s\n🔧 *Reported Issue:* %5$s\n💵 *Estimated Cost:* %6$s\n💰 *Advance Paid:* %7$s\n\nWe will update you as soon as our workbench diagnosis is completed.\nWhatsApp / Support: %8$s\nThank you for choosing %1$s!</string>
    <string name="wa_waiting_parts">*%1$s* - Repair Update\n\nHello *%2$s*,\nUpdate on your *%3$s* (Job: #%4$s).\nWe have ordered genuine replacement parts and will resume repair as soon as stock arrives.\n\nContact us: %5$s</string>
    <string name="wa_in_progress">*%1$s* - Repair In Progress\n\nHello *%2$s*,\nOur technician is currently working on your *%3$s* (Job: #%4$s).\nQuality testing is underway!</string>
    <string name="wa_ready">*%1$s* - Device Ready for Pickup! 📱✅\n\nHello *%2$s*,\nGood news! Your *%3$s* (Job: #%4$s) is fully repaired, tested, and ready for pickup.\n\n💰 *Balance Due:* %5$s\n📍 *Pickup Location:* %6$s\n\nPlease present this message or job number upon arrival.</string>
    <string name="wa_delivered">*%1$s* - Thank You!\n\nHello *%2$s*,\nYour *%3$s* has been handed over.\n🛡️ Replaced parts include our *%4$d-day warranty*.\n\nNeed help? Call / WhatsApp %5$s. Have a wonderful day!</string>
    <string name="wa_cancelled">*%1$s* - Job Notice\n\nHello *%2$s*,\nRepair for your *%3$s* (Job: #%4$s) has been cancelled.\nPlease collect your device from our counter at your convenience.</string>
    <string name="wa_khata_due">*%1$s* - Account / Payment Reminder\n\nHello *%2$s*,\nThis is a polite reminder regarding your repair account balance:\n\n%3$s\n\n💰 *Total Pending Balance:* %4$s\n📞 *Shop Contact:* %5$s\n\nPlease let us know once paid. Thank you for visiting %1$s!</string>
    <string name="wa_khata_settled">*%1$s* - Account Settled ✅\n\nHello *%2$s*,\nYour repair account with *%1$s* has %4$s pending balance across %3$d visit(s).\n\nThank you for choosing %1$s!</string>
    <string name="wa_receipt_caption">*%1$s* - Job Card Receipt #%2$s\nCustomer: %3$s | Device: %4$s</string>
