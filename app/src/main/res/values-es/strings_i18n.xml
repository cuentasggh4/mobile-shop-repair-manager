    <!-- Mensajes de WhatsApp para clientes -->
    <string name="wa_intake">*%1$s* - Confirmación de recepción\n\nHola *%2$s*,\nTu equipo *%3$s* quedó registrado para diagnóstico.\n\n📋 *Orden:* #%4$s\n🔧 *Falla reportada:* %5$s\n💵 *Costo estimado:* %6$s\n💰 *Anticipo:* %7$s\n\nTe avisaremos en cuanto termine el diagnóstico en el taller.\nWhatsApp / Soporte: %8$s\n¡Gracias por elegir %1$s!</string>
    <string name="wa_waiting_parts">*%1$s* - Avance de tu reparación\n\nHola *%2$s*,\nTe informamos sobre tu *%3$s* (Orden: #%4$s).\nYa pedimos las refacciones originales y retomaremos la reparación en cuanto lleguen.\n\nContáctanos: %5$s</string>
    <string name="wa_in_progress">*%1$s* - Reparación en proceso\n\nHola *%2$s*,\nNuestro técnico está trabajando en tu *%3$s* (Orden: #%4$s).\n¡Ya estamos en las pruebas de calidad!</string>
    <string name="wa_ready">*%1$s* - ¡Tu equipo está listo para recoger! 📱✅\n\nHola *%2$s*,\n¡Buenas noticias! Tu *%3$s* (Orden: #%4$s) ya quedó reparado, probado y listo para recoger.\n\n💰 *Saldo pendiente:* %5$s\n📍 *Lugar de entrega:* %6$s\n⏰ *Plazo límite para recoger:* %7$s\n\nPresenta este mensaje o tu número de orden al llegar.</string>
    <string name="wa_delivered">*%1$s* - ¡Gracias!\n\nHola *%2$s*,\nTu *%3$s* ya fue entregado.\n🛡️ Las refacciones cambiadas incluyen nuestra *garantía de %4$d días*.\n\n¿Necesitas ayuda? Llama o escribe por WhatsApp al %5$s. ¡Que tengas un excelente día!</string>
    <string name="wa_cancelled">*%1$s* - Aviso de orden\n\nHola *%2$s*,\nLa reparación de tu *%3$s* (Orden: #%4$s) fue cancelada.\nPor favor pasa a recoger tu equipo al mostrador cuando te convenga.</string>
    <string name="wa_khata_due">*%1$s* - Recordatorio de pago\n\nHola *%2$s*,\nTe enviamos un recordatorio amable sobre el saldo de tu cuenta de reparaciones:\n\n%3$s\n\n💰 *Saldo total pendiente:* %4$s\n📞 *Contacto del taller:* %5$s\n\nAvísanos cuando hayas pagado. ¡Gracias por visitar %1$s!</string>
    <string name="wa_khata_settled">*%1$s* - Cuenta al corriente ✅\n\nHola *%2$s*,\nTu cuenta de reparaciones con *%1$s* tiene %4$s de saldo pendiente en %3$d visita(s).\n\n¡Gracias por elegir %1$s!</string>
    <string name="wa_receipt_caption">*%1$s* - Recibo de orden de servicio #%2$s\nCliente: %3$s | Equipo: %4$s</string>
